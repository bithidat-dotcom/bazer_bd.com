{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store items for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "stock": { "type": "number" },
        "ram": { "type": "string" },
        "storage": { "type": "string" },
        "screen_hz": { "type": "string" },
        "battery": { "type": "string" },
        "watt_amp": { "type": "string" },
        "discountTimelineHours": { "type": "number" },
        "flashSaleEnd": { "type": "string" },
        "seller": { "type": "string" },
        "seller_whatsapp": { "type": "string" },
        "seller_logo": { "type": "string" },
        "rating": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase records",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "product_name": { "type": "string" },
        "price": { "type": "number" },
        "customer_name": { "type": "string" },
        "customer_username": { "type": "string" },
        "customer_uid": { "type": "string" },
        "customer_image": { "type": "string" },
        "whatsapp": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "packing", "shipping", "delivery", "completed", "cancelled", "cancelled_admin"] },
        "created_at": { "type": "string" }
      },
      "required": ["product_name", "price", "customer_name", "whatsapp"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Vendor profiles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "whatsapp": { "type": "string" },
        "logo": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" },
        "instagram": { "type": "string" },
        "is_top": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "Registered shoppers",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "location": { "type": "string" },
        "uid": { "type": "string" },
        "profileImage": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional carousel images",
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "title": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["image"]
    },
    "Review": {
      "title": "Review",
      "description": "Product ratings and comments",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "user_name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["product_id", "rating"]
    },
    "Like": {
      "title": "Like",
      "description": "Product likes tracking",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "device_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["product_id", "device_id"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Global catalog" },
    "orders": { "schema": "Order", "description": "Customer orders" },
    "sellers": { "schema": "Seller", "description": "Merchant profiles" },
    "register_people": { "schema": "User", "description": "User profiles" },
    "banners": { "schema": "Banner", "description": "Store banners" },
    "reviews": { "schema": "Review", "description": "Product reviews" },
    "likes": { "schema": "Like", "description": "Product likes" }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Public Collections (Read only for public, Admin for write)
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Admin management is handled in UI, keeping rules permissive for now as requested
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if incoming().keys().hasAll(['product_id', 'rating']) 
                    && incoming().rating is number 
                    && incoming().product_id is string;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if incoming().keys().hasAll(['product_id', 'device_id'])
                    && incoming().product_id is string
                    && incoming().device_id is string;
    }

    // Sensitive Collections
    match /orders/{orderId} {
      allow read: if true; // Admin needs to see these, and storefront needs to see status
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /register_people/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
  }
}

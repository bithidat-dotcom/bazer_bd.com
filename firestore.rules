rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    match /system_health/{documentId} {
      allow read: if true;
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if true; // In a production app, we would check for seller auth, keeping it simple for now
      allow update: if true; // Enforce seller ownership check in UI
      allow delete: if true; // Admins can delete
    }

    // Sellers Collections
    match /sellers/{username} {
      allow read: if true;
      allow write: if true;
    }

    match /sellers_auth/{username} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // User Collections
    match /register_people/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /users_secure/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
